<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:GradeCalculatorApp.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="vm:CourseGradeCalculatorInputViewModel"
             x:Class="GradeCalculatorApp.Views.CourseGradeCalculatorInputView">
	<Design.DataContext>
		<vm:CourseGradeCalculatorInputViewModel/>
	</Design.DataContext>
	<ScrollViewer>
		<ItemsControl ItemsSource="{Binding Categories}">
			<ItemsControl.ItemTemplate>
				<DataTemplate DataType="vm:CategoryViewModel">
					<Border Background="#8859b6" Margin="10">
						<Grid RowDefinitions="Auto, *">

							<!-- Category name -->
							<TextBlock Classes="h1" Text="{Binding Name}" Grid.Row="0" Margin="10, 10, 0, 0" HorizontalAlignment="Left" Foreground="White" FontWeight="Bold"/>
									
							<!-- Category Grade -->
							<TextBlock Classes="h1" Text="{Binding DisplayGrade}" Grid.Row="0" HorizontalAlignment="Right" Margin="0, 10, 10, 0" Foreground="White" FontWeight="Bold"/>

							<ItemsControl ItemsSource="{Binding Assignments}" Grid.Row="1">
								<ItemsControl.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal" />
									</ItemsPanelTemplate>
								</ItemsControl.ItemsPanel>
								<ItemsControl.ItemTemplate>
									<DataTemplate DataType="vm:AssignmentViewModel">
										<StackPanel Margin="10">
											<TextBlock Classes ="h1" Text="{Binding DisplayName}"/>
											<TextBox Classes="h1" Text="{Binding StringGrade}" Background="#6495ed"/>
										</StackPanel>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>

						</Grid>
					</Border>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</ScrollViewer>
</UserControl>
